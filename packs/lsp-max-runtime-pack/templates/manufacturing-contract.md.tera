{%- set program = sparql(query='PREFIX lsp: <https://chatmangpt.com/ns/lsp-max#> SELECT ?id ?standard ?ggenVersion ?ggenCommit ?admission ?standing ?broker ?algorithm WHERE { ?p a lsp:Program ; lsp:programId ?id ; lsp:standardVersion ?standard ; lsp:pinnedGgenVersion ?ggenVersion ; lsp:pinnedGgenCommit ?ggenCommit ; lsp:admission ?admission ; lsp:standing ?standing ; lsp:requiredBroker ?broker ; lsp:receiptAlgorithm ?algorithm . } ORDER BY ?id') | first -%}
{%- set blocks = sparql(query='PREFIX lsp: <https://chatmangpt.com/ns/lsp-max#> SELECT ?id ?facet ?realization ?lifecycle ?standing ?broker WHERE { ?b a lsp:BuildingBlock ; lsp:blockId ?id ; lsp:architectureFacet ?facet ; lsp:realization ?realization ; lsp:lifecycle ?lifecycle ; lsp:standing ?standing ; lsp:requiredBroker ?broker . } ORDER BY ?id') -%}
{%- set laws = sparql(query='PREFIX lsp: <https://chatmangpt.com/ns/lsp-max#> PREFIX skos: <http://www.w3.org/2004/02/skos/core#> SELECT ?id ?label ?statement ?token WHERE { ?law a lsp:Law ; lsp:lawId ?id ; skos:prefLabel ?label ; lsp:statement ?statement ; lsp:refusalToken ?token . } ORDER BY ?id') -%}
{%- set obligations = sparql(query='PREFIX lsp: <https://chatmangpt.com/ns/lsp-max#> PREFIX skos: <http://www.w3.org/2004/02/skos/core#> SELECT ?id ?label WHERE { ?o a lsp:EvidenceObligation ; lsp:obligationId ?id ; skos:prefLabel ?label . } ORDER BY ?id') -%}
{%- set exclusions = sparql(query='PREFIX lsp: <https://chatmangpt.com/ns/lsp-max#> SELECT ?id ?statement WHERE { ?x a lsp:Exclusion ; lsp:exclusionId ?id ; lsp:statement ?statement . } ORDER BY ?id') -%}
