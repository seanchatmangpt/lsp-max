lsp:Constraint01 a lsp:Constraint ; lsp:constraintId "INT-001" ; lsp:scope "internal" ; lsp:refusalToken "CMD-CONSTRAINT-VIOLATION" ; lsp:whenOption lsp:OptRuntimeAgnostic ; lsp:forbidsOption lsp:OptInvocationWebsocket .
lsp:Constraint02 a lsp:Constraint ; lsp:constraintId "INT-002" ; lsp:scope "internal" ; lsp:refusalToken "CMD-CONSTRAINT-VIOLATION" ; lsp:whenOption lsp:OptHistoryOcel ; lsp:requiresOption lsp:OptReceiptBlake3 .
lsp:Constraint03 a lsp:Constraint ; lsp:constraintId "INT-003" ; lsp:scope "internal" ; lsp:refusalToken "CMD-CONSTRAINT-VIOLATION" ; lsp:whenOption lsp:OptDiagnosticPush ; lsp:requiresOption lsp:OptReceiptBlake3 .
lsp:Constraint04 a lsp:Constraint ; lsp:constraintId "EXT-001" ; lsp:scope "external" ; lsp:refusalToken "EXT-IDENTITY" ; lsp:whenOption lsp:OptProtocolHttp ; lsp:requiresOption lsp:OptIdentityWorkloadToken .
lsp:Constraint05 a lsp:Constraint ; lsp:constraintId "EXT-002" ; lsp:scope "external" ; lsp:refusalToken "EXT-BOUNDARY-INCOMPLETE" ; lsp:whenOption lsp:OptConsequenceExternalMutation ; lsp:requiresOption lsp:OptAuthorityActuate, lsp:OptConsentResourceSpecific, lsp:OptEvidenceIndependentVerifier, lsp:OptExternalRuntimeNative, lsp:OptIdentityWorkloadToken, lsp:OptJurisdictionDeclaredRegion, lsp:OptTrustIndependent .
lsp:Constraint06 a lsp:Constraint ; lsp:constraintId "EXT-003" ; lsp:scope "external" ; lsp:refusalToken "AUTH-SCOPE-MISMATCH" ; lsp:whenOption lsp:OptAuthorityActuate ; lsp:requiresOption lsp:OptConsentResourceSpecific, lsp:OptConsequenceExternalMutation, lsp:OptEvidenceIndependentVerifier, lsp:OptTrustIndependent .
lsp:Constraint07 a lsp:Constraint ; lsp:constraintId "EXT-004" ; lsp:scope "external" ; lsp:refusalToken "EXT-DATA-CLASS" ; lsp:whenOption lsp:OptDataConfidential ; lsp:requiresOption lsp:OptConsentResourceSpecific, lsp:OptIdentityWorkloadToken, lsp:OptJurisdictionDeclaredRegion, lsp:OptTrustIndependent .
lsp:Constraint08 a lsp:Constraint ; lsp:constraintId "EXT-005" ; lsp:scope "external" ; lsp:refusalToken "EXT-RUNTIME-ACTUATION-REFUSED" ; lsp:whenOption lsp:OptExternalRuntimeWasm ; lsp:forbidsOption lsp:OptConsequenceExternalMutation .
lsp:Constraint09 a lsp:Constraint ; lsp:constraintId "EXT-006" ; lsp:scope "external" ; lsp:refusalToken "RCP-SELF-PROMOTION" ; lsp:whenOption lsp:OptEvidenceExecutor ; lsp:forbidsOption lsp:OptAuthorityActuate .
lsp:Constraint10 a lsp:Constraint ; lsp:constraintId "EXT-007" ; lsp:scope "external" ; lsp:refusalToken "EXT-CONSENT-MISSING" ; lsp:whenOption lsp:OptConsentAbsent ; lsp:forbidsOption lsp:OptAuthorityActuate, lsp:OptDataConfidential .
