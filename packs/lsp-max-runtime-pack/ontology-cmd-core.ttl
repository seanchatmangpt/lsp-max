@prefix lsp: <https://chatmangpt.com/ns/lsp-max#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

lsp:LspMaxProgram lsp:standardsProfile "GGEN-STANDARDS-7D-2026-07-30" ; lsp:externalStanding "UNKNOWN" ; lsp:resourcePolicy lsp:CmdResourcePolicy .
lsp:CmdResourcePolicy a lsp:ResourcePolicy ; lsp:policyId "CMD-RESOURCE-26.7.30" ; lsp:maxQueryRows 4096 ; lsp:maxOutputs 8192 ; lsp:maxArtifactBytes 10485760 ; lsp:maxSyncBytes 67108864 ; lsp:maxCandidateProduct 8192 ; lsp:maxMapeCycles 8 ; lsp:maxBenchmarkSeconds 5 .
lsp:ExactTreeObserver a lsp:Observer ; lsp:observerId "git-exact-tree-v1" ; lsp:normalizationPolicy "Git object semantics before directory inference" ; lsp:standing "UNKNOWN" .
lsp:CmdKernel a lsp:PureKernel ; lsp:kernelId "lsp-max-cmd-kernel-v1" ; lsp:ioFree true ; lsp:directActuation false .
lsp:CmdExternalVerifier a lsp:IndependentVerifier ; lsp:verifierId "lsp-max-cmd-verifier-v1" ; lsp:structurallySeparateFrom lsp:CmdKernel ; lsp:assignsAggregateStanding true ; lsp:standing "UNKNOWN" .

lsp:LiveLawRuntime lsp:conditionedInputs "admitted LSP messages" ; lsp:guaranteedOutputs "law-state responses" ; lsp:causalPolarity "intent-before-consequence" ; lsp:authorityCeiling "PROPOSE" ; lsp:resourceCeiling "CMD-RESOURCE-26.7.30" ; lsp:isolationModel "kernel-adapter-broker separation" ; lsp:hostProfile "native" ; lsp:jurisdictionProfile "local-host" ; lsp:conformityEvidence "positive witness and negative falsifier" ; lsp:independentVerifier "lsp-max-cmd-verifier-v1" ; lsp:receiptFormat "chatmangpt.cmd.receipt.v1/BLAKE3" ; lsp:replacementLaw "passport dominance and replayable equivalence" ; lsp:retirementLaw "close consumers, receipts, and replay dependencies" .
