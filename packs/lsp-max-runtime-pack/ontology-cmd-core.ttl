lsp:Law009 a lsp:Law ; lsp:lawId "LAW-009" ; skos:prefLabel "Candidate state separation" ; lsp:statement "Constructed, verified, authorized, actuated, and receipted are distinct." ; lsp:refusalToken "AUTH_PREMATURE_PROMOTION" .
lsp:Law010 a lsp:Law ; lsp:lawId "LAW-010" ; skos:prefLabel "One owner per consequence" ; lsp:statement "Every output has one exclusive owner or deterministic merge law." ; lsp:refusalToken "OWN_MULTIPLE_EXCLUSIVE" .
lsp:Law011 a lsp:Law ; lsp:lawId "LAW-011" ; skos:prefLabel "External boundary closure" ; lsp:statement "Identity, consent, trust, jurisdiction, authority, and consequence must close." ; lsp:refusalToken "EXT_BOUNDARY_INCOMPLETE" .
lsp:Law012 a lsp:Law ; lsp:lawId "LAW-012" ; skos:prefLabel "Executor cannot self-promote" ; lsp:statement "Only an independent verifier publishes aggregate standing." ; lsp:refusalToken "RCP_SELF_PROMOTION" .
