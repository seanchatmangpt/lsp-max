@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix lsp:  <https://lsp-max.rs/ontology/> .
@prefix law:  <https://lsp-max.rs/law/> .
@prefix lsif: <https://lsp-max.rs/ontology/lsif/> .

# ── Ontology declaration ──────────────────────────────────────────────────────
#
# CP1 fidelity-correction pass (Gall checkpoint 1, see ~/ggen's
# 80-20-gall-test-refactor-cheerful-quokka.md plan): this file previously
# declared only 14 vertex classes and 10 edge classes with bare (non-wire)
# edge labels, a ~40-50% subset of the real serde-tagged `Vertex`/`Edge`
# enums in crates/lsp-max-lsif/src/lsif.rs (24 vertex variants, 21 edge
# variants). Every class below now has a `lsif:wireLabel` giving the exact
# `#[serde(rename = "...")]` string lsif.rs actually emits on the wire,
# verified against tests/lsif_conformance_tests.rs and tests/emitter_witness.rs's
# own label assertions -- `rdfs:label` stays a human-readable name,
# `lsif:wireLabel` is the machine-checkable one. Edge *kinds* stay modeled
# as `owl:Class rdfs:subClassOf lsif:Edge`, matching how `lsif:Vertex`
# subclasses are already modeled here and how the real Rust `Edge` enum
# itself is one closed set of *kinds*, not a relation between two other
# classes -- the actual relation is `lsif:outV`/`lsif:inV`
# (`owl:ObjectProperty`, unchanged, already correctly modeled below).
# `lsif:ItemEdgeProperty` (the `Item` edge's `property` field -- load-bearing
# in real emitted output per `lsif_builder.rs`'s `bind_definition`/
# `bind_references`) was entirely absent before; added as a class + 7
# individuals matching the real enum's `#[serde(rename_all = "camelCase")]`
# values verbatim.

<https://lsp-max.rs/ontology/lsif/> a owl:Ontology ;
    rdfs:label   "LSIF 0.6 Schema Ontology" ;
    rdfs:comment "Language Server Index Format 0.6 schema vocabulary for semantic code indexing, symbol cross-referencing, and definition/reference tracking. Re-derived 2026-08-04 against the real Vertex/Edge enums in crates/lsp-max-lsif/src/lsif.rs, not authored independently of them." ;
    owl:imports  <https://lsp-max.rs/ontology/> ;
    owl:versionInfo "0.6.0" .

# ── Core LSIF Document Types ──────────────────────────────────────────────────

lsif:Document a owl:Class ;
    rdfs:subClassOf lsif:Vertex ;
    rdfs:label "Document" ; lsif:wireLabel "document" ;
    rdfs:comment "A source code document indexed by LSIF. Mirrors Rust Vertex::Document { uri, language_id, contents }." .

lsif:Element a owl:Class ;
    rdfs:label "Element" ;
    rdfs:comment "Base class for all LSIF elements (vertices and edges). Mirrors Rust `enum Element { Vertex(Vertex), Edge(Edge) }` (untagged)." .

lsif:Vertex a owl:Class ;
    rdfs:subClassOf lsif:Element ;
    rdfs:label "Vertex" ;
    rdfs:comment "A vertex in the LSIF graph (data element). Mirrors Rust `enum Vertex` (#[serde(tag = \"label\")])." .

lsif:Edge a owl:Class ;
    rdfs:subClassOf lsif:Element ;
    rdfs:label "Edge" ;
    rdfs:comment "An edge in the LSIF graph (relationship between vertices). Mirrors Rust `enum Edge` (#[serde(tag = \"label\")])." .

lsif:wireLabel a owl:DatatypeProperty ;
    rdfs:label "wireLabel" ;
    rdfs:comment "The exact string value LSIF emits in the NDJSON `label` field for this vertex/edge kind -- the real #[serde(rename = \"...\")] value in lsif.rs, not a human-readable name. Distinct from rdfs:label, which may differ (e.g. edge kind TextDocumentDefinition has rdfs:label \"TextDocumentDefinition\" but lsif:wireLabel \"textDocument/definition\")." ;
    rdfs:range xsd:string .

# ── Vertex Types (24, matching lsif.rs's `enum Vertex` exactly) ────────────────

lsif:MetaData a owl:Class ;
    rdfs:subClassOf lsif:Vertex ;
    rdfs:label "MetaData" ; lsif:wireLabel "metaData" ;
    rdfs:comment "Required first vertex of every LSIF dump: version, projectRoot, positionEncoding, optional toolInfo. LsifBuilder panics if this is not emitted first." .

lsif:Source a owl:Class ;
    rdfs:subClassOf lsif:Vertex ;
    rdfs:label "Source" ; lsif:wireLabel "source" ;
    rdfs:comment "Workspace root and optional repository metadata for the indexed source." .

lsif:Capabilities a owl:Class ;
    rdfs:subClassOf lsif:Vertex ;
    rdfs:label "Capabilities" ; lsif:wireLabel "capabilities" ;
    rdfs:comment "Which LSIF query capabilities this index supports (hover/declaration/definition/typeDefinition/references/documentSymbol/foldingRange/diagnostic providers)." .

lsif:Project a owl:Class ;
    rdfs:subClassOf lsif:Vertex ;
    rdfs:label "Project" ; lsif:wireLabel "project" ;
    rdfs:comment "The indexed project, keyed by language kind." .

lsif:Range a owl:Class ;
    rdfs:subClassOf lsif:Vertex ;
    rdfs:label "Range" ; lsif:wireLabel "range" ;
    rdfs:comment "A source code range (start/end Position) with an optional RangeTag (e.g. definition/reference)." .

lsif:ResultSet a owl:Class ;
    rdfs:subClassOf lsif:Vertex ;
    rdfs:label "ResultSet" ; lsif:wireLabel "resultSet" ;
    rdfs:comment "Groups multiple ranges that share the same result data (hover, definition, references, ...)." .

lsif:ResultRange a owl:Class ;
    rdfs:subClassOf lsif:Vertex ;
    rdfs:label "ResultRange" ; lsif:wireLabel "resultRange" ;
    rdfs:comment "A range vertex specialized to carry only start/end (no tag), used by result-linking edges." .

lsif:Moniker a owl:Class ;
    rdfs:subClassOf lsif:Vertex ;
    rdfs:label "Moniker" ; lsif:wireLabel "moniker" ;
    rdfs:comment "A qualified name (scheme, identifier, kind, uniqueness level) usable for cross-repository references." .

lsif:PackageInformation a owl:Class ;
    rdfs:subClassOf lsif:Vertex ;
    rdfs:label "PackageInformation" ; lsif:wireLabel "packageInformation" ;
    rdfs:comment "Package/project metadata (name, manager, version, optional repository) a Moniker belongs to." .

lsif:HoverResult a owl:Class ;
    rdfs:subClassOf lsif:Vertex ;
    rdfs:label "HoverResult" ; lsif:wireLabel "hoverResult" ;
    rdfs:comment "Result of a hover query -- carries HoverResultData (markdown/plaintext contents)." .

lsif:ReferenceResult a owl:Class ;
    rdfs:subClassOf lsif:Vertex ;
    rdfs:label "ReferenceResult" ; lsif:wireLabel "referenceResult" ;
    rdfs:comment "Result of a references query. Carries no inline payload -- linked to concrete ranges only via `item` edges." .

lsif:DeclarationResult a owl:Class ;
    rdfs:subClassOf lsif:Vertex ;
    rdfs:label "DeclarationResult" ; lsif:wireLabel "declarationResult" ;
    rdfs:comment "Result of a go-to-declaration query. Was entirely absent from this ontology before the CP1 fidelity pass." .

lsif:DefinitionResult a owl:Class ;
    rdfs:subClassOf lsif:Vertex ;
    rdfs:label "DefinitionResult" ; lsif:wireLabel "definitionResult" ;
    rdfs:comment "Result of a definition query. Carries no inline payload -- linked via `item` edges, same shape as ReferenceResult." .

lsif:ImplementationResult a owl:Class ;
    rdfs:subClassOf lsif:Vertex ;
    rdfs:label "ImplementationResult" ; lsif:wireLabel "implementationResult" ;
    rdfs:comment "Result of a go-to-implementation query. Was entirely absent from this ontology before the CP1 fidelity pass." .

lsif:TypeDefinitionResult a owl:Class ;
    rdfs:subClassOf lsif:Vertex ;
    rdfs:label "TypeDefinitionResult" ; lsif:wireLabel "typeDefinitionResult" ;
    rdfs:comment "Result of a type-definition query. Was entirely absent from this ontology before the CP1 fidelity pass." .

lsif:CallHierarchyResult a owl:Class ;
    rdfs:subClassOf lsif:Vertex ;
    rdfs:label "CallHierarchyResult" ; lsif:wireLabel "callHierarchyResult" ;
    rdfs:comment "Result of a call-hierarchy query. Was entirely absent from this ontology before the CP1 fidelity pass." .

lsif:TypeHierarchyResult a owl:Class ;
    rdfs:subClassOf lsif:Vertex ;
    rdfs:label "TypeHierarchyResult" ; lsif:wireLabel "typeHierarchyResult" ;
    rdfs:comment "Result of a type-hierarchy query. Was entirely absent from this ontology before the CP1 fidelity pass." .

lsif:FoldingRangeResult a owl:Class ;
    rdfs:subClassOf lsif:Vertex ;
    rdfs:label "FoldingRangeResult" ; lsif:wireLabel "foldingRangeResult" ;
    rdfs:comment "Result of a folding-range query -- carries the real Vec<lsp_types_max::FoldingRange> payload inline. Was entirely absent from this ontology before the CP1 fidelity pass." .

lsif:DocumentLinkResult a owl:Class ;
    rdfs:subClassOf lsif:Vertex ;
    rdfs:label "DocumentLinkResult" ; lsif:wireLabel "documentLinkResult" ;
    rdfs:comment "Result of a document-link query -- carries the real Vec<lsp_types_max::DocumentLink> payload inline. Was entirely absent from this ontology before the CP1 fidelity pass." .

lsif:DocumentSymbolResult a owl:Class ;
    rdfs:subClassOf lsif:Vertex ;
    rdfs:label "DocumentSymbolResult" ; lsif:wireLabel "documentSymbolResult" ;
    rdfs:comment "Result of a documentSymbol query -- carries DocumentSymbolResultData inline. Was entirely absent from this ontology before the CP1 fidelity pass (the old file had a separate, non-matching lsif:DocumentSymbol vertex class instead)." .

lsif:DiagnosticResult a owl:Class ;
    rdfs:subClassOf lsif:Vertex ;
    rdfs:label "DiagnosticResult" ; lsif:wireLabel "diagnosticResult" ;
    rdfs:comment "Diagnostic information for a document -- carries the real Vec<lsp_types_max::Diagnostic> payload inline." .

lsif:SemanticTokensResult a owl:Class ;
    rdfs:subClassOf lsif:Vertex ;
    rdfs:label "SemanticTokensResult" ; lsif:wireLabel "semanticTokensResult" ;
    rdfs:comment "Result of a semantic-tokens query -- carries SemanticTokensData inline. Was entirely absent from this ontology before the CP1 fidelity pass." .

lsif:Event a owl:Class ;
    rdfs:subClassOf lsif:Vertex ;
    rdfs:label "Event" ; lsif:wireLabel "$event" ;
    rdfs:comment "Scope begin/end marker (kind, scope, data vertex id) used to bracket per-document or per-project vertex ranges. Was entirely absent from this ontology before the CP1 fidelity pass." .

# ── Edge Types (21, matching lsif.rs's `enum Edge` exactly) ────────────────────

lsif:contains a owl:Class ;
    rdfs:subClassOf lsif:Edge ;
    rdfs:label "contains" ; lsif:wireLabel "contains" ;
    rdfs:comment "Document/Project contains Range (or Document) vertices. outV -> inVs (multi-target)." .

lsif:next a owl:Class ;
    rdfs:subClassOf lsif:Edge ;
    rdfs:label "next" ; lsif:wireLabel "next" ;
    rdfs:comment "Chains a Range/ResultSet to the ResultSet holding its shared result data." .

lsif:moniker a owl:Class ;
    rdfs:subClassOf lsif:Edge ;
    rdfs:label "moniker" ; lsif:wireLabel "moniker" ;
    rdfs:comment "Relates a Range/ResultSet to its Moniker." .

lsif:nextMoniker a owl:Class ;
    rdfs:subClassOf lsif:Edge ;
    rdfs:label "nextMoniker" ; lsif:wireLabel "nextMoniker" ;
    rdfs:comment "Links two Monikers as denoting the same symbol (cross-repository linkage). Was entirely absent from this ontology before the CP1 fidelity pass." .

lsif:belongsTo a owl:Class ;
    rdfs:subClassOf lsif:Edge ;
    rdfs:label "belongsTo" ; lsif:wireLabel "belongsTo" ;
    rdfs:comment "Relates a Moniker to its PackageInformation. Was entirely absent from this ontology before the CP1 fidelity pass." .

lsif:attach a owl:Class ;
    rdfs:subClassOf lsif:Edge ;
    rdfs:label "attach" ; lsif:wireLabel "attach" ;
    rdfs:comment "Attaches an Event vertex to the vertex it brackets. Was entirely absent from this ontology before the CP1 fidelity pass." .

lsif:packageInformationEdge a owl:Class ;
    rdfs:subClassOf lsif:Edge ;
    rdfs:label "packageInformation (edge)" ; lsif:wireLabel "packageInformation" ;
    rdfs:comment "Edge form of packageInformation (outV/inV), distinct from lsif:packageInformation the vertex class below -- lsif.rs's Edge::PackageInformation variant. Was entirely absent from this ontology before the CP1 fidelity pass (the old file only had the vertex, under a different local name lsif:packageInformation, causing a real name collision this pass renamed to disambiguate)." .

lsif:item a owl:Class ;
    rdfs:subClassOf lsif:Edge ;
    rdfs:label "item" ; lsif:wireLabel "item" ;
    rdfs:comment "Links a DefinitionResult/ReferenceResult/... vertex to its concrete Range(s) within a specific document, optionally tagged with an lsif:ItemEdgeProperty. Was entirely absent from this ontology before the CP1 fidelity pass despite being load-bearing in real emitted output (lsif_builder.rs's bind_definition/bind_references)." .

lsif:textDocumentHover a owl:Class ;
    rdfs:subClassOf lsif:Edge ;
    rdfs:label "TextDocumentHover" ; lsif:wireLabel "textDocument/hover" ;
    rdfs:comment "Range/ResultSet has hover information." .

lsif:textDocumentDefinition a owl:Class ;
    rdfs:subClassOf lsif:Edge ;
    rdfs:label "TextDocumentDefinition" ; lsif:wireLabel "textDocument/definition" ;
    rdfs:comment "Range/ResultSet points to its DefinitionResult. Wire label corrected from the old bare lsif:definition; the old file's edge label lost the textDocument/ LSP-method namespace that is actually on the wire." .

lsif:textDocumentDeclaration a owl:Class ;
    rdfs:subClassOf lsif:Edge ;
    rdfs:label "TextDocumentDeclaration" ; lsif:wireLabel "textDocument/declaration" ;
    rdfs:comment "Range/ResultSet points to its DeclarationResult. Was entirely absent from this ontology before the CP1 fidelity pass." .

lsif:textDocumentReferences a owl:Class ;
    rdfs:subClassOf lsif:Edge ;
    rdfs:label "TextDocumentReferences" ; lsif:wireLabel "textDocument/references" ;
    rdfs:comment "Range/ResultSet has references via ReferenceResult. Wire label corrected from the old bare lsif:references." .

lsif:textDocumentImplementation a owl:Class ;
    rdfs:subClassOf lsif:Edge ;
    rdfs:label "TextDocumentImplementation" ; lsif:wireLabel "textDocument/implementation" ;
    rdfs:comment "Range/ResultSet has implementation references. Wire label corrected from the old bare lsif:implementation." .

lsif:textDocumentTypeDefinition a owl:Class ;
    rdfs:subClassOf lsif:Edge ;
    rdfs:label "TextDocumentTypeDefinition" ; lsif:wireLabel "textDocument/typeDefinition" ;
    rdfs:comment "Range/ResultSet has a type definition. Wire label corrected from the old bare lsif:typeDefinition." .

lsif:textDocumentCallHierarchy a owl:Class ;
    rdfs:subClassOf lsif:Edge ;
    rdfs:label "TextDocumentCallHierarchy" ; lsif:wireLabel "textDocument/callHierarchy" ;
    rdfs:comment "Range/ResultSet has a CallHierarchyResult. Was entirely absent from this ontology before the CP1 fidelity pass." .

lsif:textDocumentTypeHierarchy a owl:Class ;
    rdfs:subClassOf lsif:Edge ;
    rdfs:label "TextDocumentTypeHierarchy" ; lsif:wireLabel "textDocument/typeHierarchy" ;
    rdfs:comment "Range/ResultSet has a TypeHierarchyResult. Was entirely absent from this ontology before the CP1 fidelity pass." .

lsif:textDocumentFoldingRange a owl:Class ;
    rdfs:subClassOf lsif:Edge ;
    rdfs:label "TextDocumentFoldingRange" ; lsif:wireLabel "textDocument/foldingRange" ;
    rdfs:comment "Document has a FoldingRangeResult. Was entirely absent from this ontology before the CP1 fidelity pass." .

lsif:textDocumentDocumentLink a owl:Class ;
    rdfs:subClassOf lsif:Edge ;
    rdfs:label "TextDocumentDocumentLink" ; lsif:wireLabel "textDocument/documentLink" ;
    rdfs:comment "Document has a DocumentLinkResult. Wire label corrected from the old bare lsif:documentLink." .

lsif:textDocumentDocumentSymbol a owl:Class ;
    rdfs:subClassOf lsif:Edge ;
    rdfs:label "TextDocumentDocumentSymbol" ; lsif:wireLabel "textDocument/documentSymbol" ;
    rdfs:comment "Document has a DocumentSymbolResult. Was entirely absent from this ontology before the CP1 fidelity pass." .

lsif:textDocumentDiagnostic a owl:Class ;
    rdfs:subClassOf lsif:Edge ;
    rdfs:label "TextDocumentDiagnostic" ; lsif:wireLabel "textDocument/diagnostic" ;
    rdfs:comment "Document has diagnostic results. Wire label corrected from the old bare lsif:diagnostic." .

lsif:textDocumentSemanticTokens a owl:Class ;
    rdfs:subClassOf lsif:Edge ;
    rdfs:label "TextDocumentSemanticTokens" ; lsif:wireLabel "textDocument/semanticTokens/full" ;
    rdfs:comment "Document has a SemanticTokensResult. Was entirely absent from this ontology before the CP1 fidelity pass." .

# ── Item edge property (7 values, matching lsif.rs's `ItemEdgeProperty` exactly) ─

lsif:ItemEdgeProperty a owl:Class ;
    rdfs:label "ItemEdgeProperty" ;
    rdfs:comment "Closed value set for lsif:item edges' optional `property` field, disambiguating what kind of item-linkage this is. Entirely absent from this ontology before the CP1 fidelity pass, despite lsif_builder.rs's bind_definition/bind_references relying on it." .

lsif:itemProperty_definitions a lsif:ItemEdgeProperty ;
    rdfs:label "definitions" ; lsif:wireLabel "definitions" .

lsif:itemProperty_declarations a lsif:ItemEdgeProperty ;
    rdfs:label "declarations" ; lsif:wireLabel "declarations" .

lsif:itemProperty_references a lsif:ItemEdgeProperty ;
    rdfs:label "references" ; lsif:wireLabel "references" .

lsif:itemProperty_referenceResults a lsif:ItemEdgeProperty ;
    rdfs:label "referenceResults" ; lsif:wireLabel "referenceResults" .

lsif:itemProperty_implementationResults a lsif:ItemEdgeProperty ;
    rdfs:label "implementationResults" ; lsif:wireLabel "implementationResults" .

lsif:itemProperty_typeDefinitions a lsif:ItemEdgeProperty ;
    rdfs:label "typeDefinitions" ; lsif:wireLabel "typeDefinitionResults" ;
    rdfs:comment "Note the real Rust variant name (TypeDefinitions) and its wire rename (typeDefinitionResults) differ -- #[serde(rename = \"typeDefinitionResults\")] on lsif.rs's ItemEdgeProperty::TypeDefinitions. Both are captured here rather than assumed identical." .

lsif:itemProperty_referenceLinks a lsif:ItemEdgeProperty ;
    rdfs:label "referenceLinks" ; lsif:wireLabel "referenceLinks" .

# ── Properties ────────────────────────────────────────────────────────────────

lsif:id a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:comment "Unique identifier for an LSIF element." ;
    rdfs:range xsd:string .

lsif:uri a owl:DatatypeProperty ;
    rdfs:label "uri" ;
    rdfs:comment "Document URI." ;
    rdfs:range xsd:string .

lsif:languageId a owl:DatatypeProperty ;
    rdfs:label "languageId" ;
    rdfs:comment "Language identifier (e.g., 'rust', 'java', 'typescript')." ;
    rdfs:range xsd:string .

lsif:start a owl:DatatypeProperty ;
    rdfs:label "start" ;
    rdfs:comment "Starting position (line and character)." ;
    rdfs:range xsd:string .

lsif:end a owl:DatatypeProperty ;
    rdfs:label "end" ;
    rdfs:comment "Ending position (line and character)." ;
    rdfs:range xsd:string .

lsif:contents a owl:DatatypeProperty ;
    rdfs:label "contents" ;
    rdfs:comment "Hover or documentation contents." ;
    rdfs:range xsd:string .

lsif:kind a owl:DatatypeProperty ;
    rdfs:label "kind" ;
    rdfs:comment "Kind of symbol (e.g., 'Class', 'Method', 'Variable'), or Project's language kind, or Event's begin/end kind depending on the vertex it's attached to." ;
    rdfs:range xsd:string .

lsif:detail a owl:DatatypeProperty ;
    rdfs:label "detail" ;
    rdfs:comment "Additional detail about a symbol." ;
    rdfs:range xsd:string .

lsif:deprecated a owl:DatatypeProperty ;
    rdfs:label "deprecated" ;
    rdfs:comment "Whether the symbol is deprecated." ;
    rdfs:range xsd:boolean .

lsif:outV a owl:ObjectProperty ;
    rdfs:label "outV" ;
    rdfs:domain lsif:Edge ;
    rdfs:comment "Source vertex of an edge." .

lsif:inV a owl:ObjectProperty ;
    rdfs:label "inV" ;
    rdfs:domain lsif:Edge ;
    rdfs:comment "Target vertex of an edge." .

lsif:outVs a owl:ObjectProperty ;
    rdfs:label "outVs" ;
    rdfs:domain lsif:Edge ;
    rdfs:comment "Multiple source vertices (for multi-vertex edges)." .

lsif:inVs a owl:ObjectProperty ;
    rdfs:label "inVs" ;
    rdfs:domain lsif:Edge ;
    rdfs:comment "Multiple target vertices -- used by lsif:contains and lsif:item (Rust field name in_vs)." .

lsif:fromRanges a owl:ObjectProperty ;
    rdfs:label "fromRanges" ;
    rdfs:comment "Reference source ranges." .

lsif:toRanges a owl:ObjectProperty ;
    rdfs:label "toRanges" ;
    rdfs:comment "Reference target ranges." .

lsif:symbol a owl:DatatypeProperty ;
    rdfs:label "symbol" ;
    rdfs:comment "Fully qualified symbol name." ;
    rdfs:range xsd:string .

lsif:signature a owl:DatatypeProperty ;
    rdfs:label "signature" ;
    rdfs:comment "Symbol signature (e.g., method signature)." ;
    rdfs:range xsd:string .

lsif:document a owl:ObjectProperty ;
    rdfs:label "document" ;
    rdfs:domain lsif:item ;
    rdfs:comment "The item edge's own `document: Id` field -- which document the linked ranges belong to. Was entirely absent from this ontology before the CP1 fidelity pass." .

lsif:property a owl:ObjectProperty ;
    rdfs:label "property" ;
    rdfs:domain lsif:item ;
    rdfs:range lsif:ItemEdgeProperty ;
    rdfs:comment "The item edge's optional `property` field. Was entirely absent from this ontology before the CP1 fidelity pass." .

# ── Query Types ───────────────────────────────────────────────────────────────

lsif:Query a owl:Class ;
    rdfs:label "Query" ;
    rdfs:comment "LSIF-supported query type." .

lsif:query_definition a lsif:Query ;
    rdfs:label "definition query" ;
    rdfs:comment "Go-to-definition query." .

lsif:query_references a lsif:Query ;
    rdfs:label "references query" ;
    rdfs:comment "Find-references query." .

lsif:query_hover a lsif:Query ;
    rdfs:label "hover query" ;
    rdfs:comment "Hover information query." .

lsif:query_documentSymbol a lsif:Query ;
    rdfs:label "documentSymbol query" ;
    rdfs:comment "Document symbols query." .

lsif:query_workspaceSymbol a lsif:Query ;
    rdfs:label "workspaceSymbol query" ;
    rdfs:comment "Workspace symbols query." .

lsif:query_typeDefinition a lsif:Query ;
    rdfs:label "typeDefinition query" ;
    rdfs:comment "Type definition query." .

lsif:query_implementation a lsif:Query ;
    rdfs:label "implementation query" ;
    rdfs:comment "Implementation references query." .

# ── Moniker-adjacent properties ─────────────────────────────────────────────────

lsif:monikerKind a owl:DatatypeProperty ;
    rdfs:label "monikerKind" ;
    rdfs:comment "Moniker kind: 'import' or 'export' (Rust MonikerKind)." ;
    rdfs:range xsd:string .

lsif:identifier a owl:DatatypeProperty ;
    rdfs:label "identifier" ;
    rdfs:comment "The actual moniker identifier." ;
    rdfs:range xsd:string .

lsif:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:comment "Package or symbol name." ;
    rdfs:range xsd:string .

lsif:version a owl:DatatypeProperty ;
    rdfs:label "version" ;
    rdfs:comment "Package version." ;
    rdfs:range xsd:string .

# ── Index Information ─────────────────────────────────────────────────────────

lsif:IndexInformation a owl:Class ;
    rdfs:label "IndexInformation" ;
    rdfs:comment "Metadata about an LSIF index. Deliberately NOT rdfs:subClassOf lsif:Vertex (fixed during CP2's gate pass, which correctly refused it for lacking a lsif:wireLabel): this is a documentation/spec-level convenience class with no direct 1:1 Rust enum variant, not a real wire-emitted vertex kind -- its fields below correspond to lsif:MetaData's real fields (version/projectRoot/toolInfo) plus workspace-level summary data lsif.rs does not itself model as one vertex." .

lsif:projectRoot a owl:DatatypeProperty ;
    rdfs:label "projectRoot" ;
    rdfs:comment "Root directory of the indexed project." ;
    rdfs:range xsd:string .

lsif:indexedLanguages a owl:DatatypeProperty ;
    rdfs:label "indexedLanguages" ;
    rdfs:comment "Languages indexed in this LSIF file." ;
    rdfs:range xsd:string .

lsif:toolInfo a owl:DatatypeProperty ;
    rdfs:label "toolInfo" ;
    rdfs:comment "Information about the indexing tool." ;
    rdfs:range xsd:string .

lsif:toolVersion a owl:DatatypeProperty ;
    rdfs:label "toolVersion" ;
    rdfs:comment "Version of the indexing tool." ;
    rdfs:range xsd:string .

# ── Compliance ────────────────────────────────────────────────────────────────

lsif:lsif06_supported a lsp:MaxExtension ;
    lsp:methodName "lsif/export" ;
    lsp:snakeName  "lsif_export" ;
    lsp:paramType  "LsifExportParams" ;
    lsp:returnType "LsifIndex" ;
    rdfs:comment   "Export workspace or symbol index in LSIF 0.6 format." ;
    law:status     law:CANDIDATE .

lsif:lsif06_import a lsp:MaxExtension ;
    lsp:methodName "lsif/import" ;
    lsp:snakeName  "lsif_import" ;
    lsp:paramType  "LsifImportParams" ;
    lsp:returnType "LsifImportResult" ;
    rdfs:comment   "Load and parse an LSIF 0.6 index file." ;
    law:status     law:CANDIDATE .

lsif:lsif06_query a lsp:MaxExtension ;
    lsp:methodName "lsif/query" ;
    lsp:snakeName  "lsif_query" ;
    lsp:paramType  "LsifQueryParams" ;
    lsp:returnType "LsifQueryResult" ;
    rdfs:comment   "Query an indexed LSIF database." ;
    law:status     law:CANDIDATE .
