@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix test: <https://lsp-max.rs/ontology/test/> .

# ── Ontology declaration ──────────────────────────────────────────────────────
#
# Test-inventory ontology for the Gall's-Law-checkpoint test files this session
# (CP0-CP12, see ~/ggen's `80-20-gall-test-refactor-cheerful-quokka.md`) added to
# lsp-max. Scope is deliberately narrow: only the 8 real test files / 27 real test
# functions those checkpoints added, not the pre-existing 331-test suite. Makes
# "what does this test actually prove" a queryable fact instead of something an
# agent has to re-derive by reading test source every time -- the same move CP6
# made for handler stub contracts (`lsp:expectsBinding`/`lsp:producesShape`).

<https://lsp-max.rs/ontology/test/> a owl:Ontology ;
    rdfs:label   "lsp-max Test Inventory Ontology" ;
    rdfs:comment "Per-test-function facts for the CP0-CP12 Gall's-Law-checkpoint test files: what each test asserts, and what real artifact/behavior its pass actually proves." .

# ── Core classes ─────────────────────────────────────────────────────────────

test:TestFile a owl:Class ;
    rdfs:label   "TestFile" ;
    rdfs:comment "A real Rust test file (integration test or #[cfg(test)] module) under test." .

test:TestCase a owl:Class ;
    rdfs:label   "TestCase" ;
    rdfs:comment "A single #[test] or #[tokio::test] function." .

test:AssertionKind a owl:Class ;
    rdfs:label   "AssertionKind" ;
    rdfs:comment "Closed set of assertion shapes used across this inventory. Closed (not free text) so an agent can group/filter by mechanism without parsing prose -- e.g. 'find every DriftInjectionRevert test' answers 'which tests actually prove their gate/check is not vacuous', a distinct and higher-value query than grepping assert_eq!." .

# ── AssertionKind individuals ────────────────────────────────────────────────
# Closed set, one per distinct assertion *mechanism* observed across the 27
# real test functions below (verified by reading each file in full, not
# inferred from function names).

test:StructuralParse a test:AssertionKind ;
    rdfs:label "StructuralParse" ;
    rdfs:comment "Asserts a TTL file parses as valid Turtle / yields >0 triples. No semantic content check." .

test:SetEquality a test:AssertionKind ;
    rdfs:label "SetEquality" ;
    rdfs:comment "Asserts a SPARQL-derived BTreeSet/collection equals a hand-transcribed EXPECTED set exactly (assert_eq! on two sets, not a subset/superset check)." .

test:CountEquality a test:AssertionKind ;
    rdfs:label "CountEquality" ;
    rdfs:comment "Asserts a numeric count (gate-violation count, SPARQL COUNT aggregate, or collection length) equals a specific expected integer." .

test:MembershipCheck a test:AssertionKind ;
    rdfs:label "MembershipCheck" ;
    rdfs:comment "Asserts every element of one set is contained in another (e.g. every ADMITTED method name is present in a real-registration list) -- a one-directional containment check, not full set equality." .

test:DriftInjectionRevert a test:AssertionKind ;
    rdfs:label "DriftInjectionRevert" ;
    rdfs:comment "Deliberately corrupts an in-memory copy of real TTL content, asserts the gate/check now refuses it, then asserts the real on-disk file (never mutated) still passes cleanly -- proves a check is a real detector, not a vacuously-passing no-op." .

test:StateTransition a test:AssertionKind ;
    rdfs:label "StateTransition" ;
    rdfs:comment "Drives a real state change (e.g. an admission verdict flip) through real production code and asserts a real downstream effect (a notification reaching a real client) occurred with the correct payload." .

test:NoTransition a test:AssertionKind ;
    rdfs:label "NoTransition" ;
    rdfs:comment "Asserts that when no real state change occurs, no downstream effect (e.g. no notification) is produced -- proves change-detection is real, not blind re-send-on-every-poll." .

test:FieldContent a test:AssertionKind ;
    rdfs:label "FieldContent" ;
    rdfs:comment "Asserts a specific field/property value on a queried individual matches expected real content (e.g. a paramType string references a real Rust struct name)." .

# ── TestFile individuals ─────────────────────────────────────────────────────

test:File_lsif06_ontology_fidelity_proof a test:TestFile ;
    rdfs:label "lsif06_ontology_fidelity_proof.rs" ;
