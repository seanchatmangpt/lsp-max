# ── TestCase individuals: tests/lsif06_ontology_fidelity_proof.rs (CP1) ──────

test:tc_lsif06_ttl_parses_as_valid_turtle a test:TestCase ;
    test:file test:File_lsif06_ontology_fidelity_proof ;
    test:function "lsif06_ttl_parses_as_valid_turtle" ;
    test:assertionKind test:StructuralParse ;
    test:asserts "ontology/lsif06.ttl loads into an in-memory oxigraph Store without a parse error" ;
    test:provesReal "lsif06.ttl is syntactically valid Turtle, the precondition every other lsif06 test in this inventory depends on" .

test:tc_vertex_wire_labels_match a test:TestCase ;
    test:file test:File_lsif06_ontology_fidelity_proof ;
    test:function "vertex_wire_labels_match_the_real_lsif_rs_enum_exactly" ;
    test:assertionKind test:SetEquality ;
    test:asserts "the SPARQL-derived set of lsif:Vertex subclasses' lsif:wireLabel values equals a hand-transcribed EXPECTED_VERTEX_WIRE_LABELS set (24 labels, transcribed from lsif.rs's #[serde(rename)] attributes, not from the ontology)" ;
    test:provesReal "the ontology's Vertex wire-label set is fidelity-correct against the real lsp-max-lsif::lsif::Vertex enum -- the exact drift class CP0's research found (lsif06.ttl was a hand-curated 40-50% subset before CP1)" .

test:tc_edge_wire_labels_match a test:TestCase ;
    test:file test:File_lsif06_ontology_fidelity_proof ;
    test:function "edge_wire_labels_match_the_real_lsif_rs_enum_exactly" ;
    test:assertionKind test:SetEquality ;
    test:asserts "the SPARQL-derived set of lsif:Edge subclasses' lsif:wireLabel values equals a hand-transcribed EXPECTED_EDGE_WIRE_LABELS set (21 labels, including the real textDocument/* namespace)" ;
    test:provesReal "the ontology's Edge wire-label set is fidelity-correct against the real lsp-max-lsif::lsif::Edge enum, including the textDocument/* wire-format namespace CP0 found entirely missing pre-CP1" .

test:tc_item_edge_property_values_match a test:TestCase ;
    test:file test:File_lsif06_ontology_fidelity_proof ;
    test:function "item_edge_property_values_match_the_real_lsif_rs_enum_exactly" ;
    test:assertionKind test:SetEquality ;
    test:asserts "the SPARQL-derived set of lsif:ItemEdgeProperty individuals' wireLabel values equals a hand-transcribed EXPECTED_ITEM_EDGE_PROPERTIES set (7 values, including the intentional Rust-name/wire-value mismatch TypeDefinitions -> \"typeDefinitionResults\")" ;
    test:provesReal "the ontology correctly captures the real ItemEdgeProperty enum's wire values, including at least one case where the Rust variant name and its wire rename genuinely diverge -- a case a naive transcription could get wrong" .

test:tc_vertex_and_edge_wire_label_counts_match a test:TestCase ;
    test:file test:File_lsif06_ontology_fidelity_proof ;
    test:function "vertex_and_edge_wire_label_counts_match_lsif_rs_variant_counts" ;
    test:assertionKind test:CountEquality ;
    test:asserts "SPARQL-derived Vertex wireLabel count == 24 and Edge wireLabel count == 21" ;
    test:provesReal "the ontology declares exactly as many Vertex/Edge subclasses as the real enums have variants -- no silent under- or over-declaration" .

# ── TestCase individuals: tests/lsif06_gates_and_sparql_derived_proof.rs (CP2) ──

test:tc_all_three_gates_pass_zero_violations a test:TestCase ;
    test:file test:File_lsif06_gates_and_sparql_derived_proof ;
    test:function "all_three_gates_pass_zero_violations_on_the_corrected_ontology" ;
    test:assertionKind test:CountEquality ;
    test:asserts "gates/{010_required,020_single_valued,030_value_constraints}.rq each return zero violation rows against the real ontology/lsif06.ttl" ;
    test:provesReal "the corrected lsif06.ttl passes all three admission gates cleanly -- required fields present, no double-valued wireLabels, and every TextDocument*-named edge class carries its real textDocument/ wire prefix" .

test:tc_sparql_derived_totals_agree_with_cp1 a test:TestCase ;
    test:file test:File_lsif06_gates_and_sparql_derived_proof ;
    test:function "sparql_derived_vertex_and_edge_totals_agree_with_cp1s_hand_transcribed_proof" ;
    test:assertionKind test:CountEquality ;
    test:asserts "an independently-shaped COUNT+GROUP aggregate SPARQL query re-derives vertexCount == 24 and edgeCount == 21, agreeing with CP1's per-class enumeration proof" ;
    test:provesReal "the 24/21 totals are not an artifact of one particular query shape -- two differently-shaped queries agreeing is the SPARQL-derived second-proof half of the CP1/CP2 dual-proof pattern" .

test:tc_gate_030_refuses_reintroduced_bare_label a test:TestCase ;
    test:file test:File_lsif06_gates_and_sparql_derived_proof ;
    test:function "gate_030_refuses_a_deliberately_reintroduced_pre_cp1_bare_wire_label" ;
    test:assertionKind test:DriftInjectionRevert ;
    test:asserts "an in-memory copy of lsif06.ttl with textDocument/definition's wireLabel corrupted back to the bare pre-CP1 form \"definition\" makes gate 030's violation count > 0; the real on-disk file (untouched) still passes gate 030 with zero violations" ;
    test:provesReal "gate 030 is a real, working regression detector for the exact bug class CP1 fixed -- not a check that vacuously always passes" .

# ── TestCase individuals: tests/lsp318_admitted_status_drift_proof.rs (CP4) ──

test:tc_lsp318_ttl_parses a test:TestCase ;
    test:file test:File_lsp318_admitted_status_drift_proof ;
    test:function "lsp318_ttl_parses_as_valid_turtle" ;
    test:assertionKind test:StructuralParse ;
    test:asserts "ontology/lsp318.ttl loads into an in-memory oxigraph Store without a parse error" ;
    test:provesReal "lsp318.ttl is syntactically valid Turtle, the precondition every other lsp318 test in this inventory depends on" .

test:tc_every_admitted_method_is_registered a test:TestCase ;
    test:file test:File_lsp318_admitted_status_drift_proof ;
    test:function "every_admitted_method_is_actually_registered" ;
    test:assertionKind test:MembershipCheck ;
    test:asserts "every lsp:methodName whose law:status is law:ADMITTED is a member of EXPECTED_REGISTERED (a literal copy of lsp_coverage::IMPLEMENTED_METHODS, itself grep-verified against real #[rpc(name=\"...\")] attributes)" ;
    test:provesReal "no method the ontology claims is ADMITTED lacks a real #[rpc] registration anywhere in the workspace -- currently holds vacuously (zero ADMITTED methods exist), proven non-tautological by the drift-injection test below" .

test:tc_admitted_set_is_currently_empty a test:TestCase ;
    test:file test:File_lsp318_admitted_status_drift_proof ;
    test:function "admitted_set_is_currently_empty_this_is_a_real_finding" ;
    test:assertionKind test:CountEquality ;
    test:asserts "the SPARQL-derived set of law:ADMITTED method names is empty" ;
    test:provesReal "as of this checkpoint's authoring, base lsp318.ttl declares zero ADMITTED methods -- all 57 lsp:Request/lsp:Notification individuals are still law:CANDIDATE; a real, non-silent finding this test will start failing (correctly) the moment CP5 or any later work flips a method to ADMITTED" .

test:tc_sparql_derived_status_breakdown a test:TestCase ;
    test:file test:File_lsp318_admitted_status_drift_proof ;
    test:function "sparql_derived_status_breakdown_matches_hand_counted_grep_totals" ;
    test:assertionKind test:CountEquality ;
    test:asserts "an independently-shaped SELECT-all + rdfs:label join re-derives 57 total method individuals with a (CANDIDATE, ADMITTED, REFUSED, UNKNOWN) status breakdown of exactly (57, 0, 0, 0), agreeing with a `grep -c`/`grep -o | sort | uniq -c` hand count against the real file" ;
    test:provesReal "the 45-Request + 12-Notification = 57 individual count, and the fact all 57 are CANDIDATE, is not an artifact of one query shape -- the SPARQL-derived second-proof half of the CP4 dual-proof pattern" .

test:tc_admitted_check_refuses_injected_drift a test:TestCase ;
    test:file test:File_lsp318_admitted_status_drift_proof ;
    test:function "admitted_check_refuses_a_deliberately_injected_admitted_but_unregistered_method" ;
    test:assertionKind test:DriftInjectionRevert ;
    test:asserts "an in-memory copy of lsp318.ttl with lsp:exit's law:status flipped CANDIDATE -> ADMITTED makes the admitted-but-unregistered check catch \"exit\" (genuinely absent from EXPECTED_REGISTERED, since exit is a transport-layer message below the LanguageServer trait); the real on-disk file (untouched) still has zero ADMITTED methods" ;
    test:provesReal "the every_admitted_method_is_actually_registered check above is a real detector, not a vacuously-passing no-op that only looks meaningful because the ADMITTED set happens to be empty today" .

# ── TestCase individuals: tests/lsp318_candidate_contracts_are_queryable.rs (CP6) ──

test:tc_lsp318_ttl_parses_into_oxigraph a test:TestCase ;
    test:file test:File_lsp318_candidate_contracts_are_queryable ;
    test:function "lsp318_ttl_parses_into_oxigraph" ;
    test:assertionKind test:StructuralParse ;
    test:asserts "ontology/lsp318.ttl parses into at least one triple" ;
    test:provesReal "lsp318.ttl is loadable and non-empty, the precondition the CP6 contract-queryability tests below depend on" .

test:tc_gate_zero_candidate_missing_contract_facts a test:TestCase ;
    test:file test:File_lsp318_candidate_contracts_are_queryable ;
    test:function "gate_zero_candidate_individuals_missing_expects_binding_or_produces_shape" ;
    test:assertionKind test:CountEquality ;
    test:asserts "a FILTER NOT EXISTS gate query for CANDIDATE lsp:Request/lsp:Notification/lsp:MaxExtension individuals missing lsp:expectsBinding, and a second gate for lsp:producesShape, both return zero rows" ;
    test:provesReal "every still-CANDIDATE handler/method individual in lsp318.ttl carries CP6's new lsp:expectsBinding and lsp:producesShape facts -- the CP6 retrofit is complete, not partial" .

test:tc_candidate_contracts_query_matches_expected a test:TestCase ;
    test:file test:File_lsp318_candidate_contracts_are_queryable ;
    test:function "candidate_contracts_query_matches_hand_transcribed_expected_pairs" ;
    test:assertionKind test:SetEquality ;
    test:asserts "queries/lsp-max/candidate_contracts.sparql's result rows (method_name, expects_binding, produces_shape) exactly match a hand-transcribed 57-entry EXPECTED map, read directly from lsp318.ttl's real lsp:paramType/lsp:returnType values, not derived from the query under test" ;
    test:provesReal "candidate_contracts.sparql is the literal, working precondition CP9's ggen-mcp introspection tool needs: a still-CANDIDATE handler's required input/output contract is retrievable via one SPARQL query with zero Rust source reads" .

test:tc_drift_injection_catches_removed_binding a test:TestCase ;
    test:file test:File_lsp318_candidate_contracts_are_queryable ;
    test:function "drift_injection_and_revert_gate_catches_a_removed_expects_binding_fact" ;
    test:assertionKind test:DriftInjectionRevert ;
    test:asserts "an in-memory copy of lsp318.ttl with textDocument/hover's lsp:expectsBinding fact stripped makes the missing-expectsBinding gate report exactly one violation; the real on-disk file (untouched) still reports zero" ;
    test:provesReal "the CP6 contract-completeness gate is a real detector for a missing expectsBinding/producesShape fact, not a check that only looks meaningful on a fully-populated graph" .

