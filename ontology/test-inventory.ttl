test:File_lsp318_candidate_contracts_are_queryable a test:TestFile ;
    rdfs:label "lsp318_candidate_contracts_are_queryable.rs" ;
    test:path "tests/lsp318_candidate_contracts_are_queryable.rs" ;
    test:checkpoint "CP6" ;
    test:testCount 4 .

test:File_max_protocol_notification_fidelity_proof a test:TestFile ;
    rdfs:label "max_protocol_notification_fidelity_proof.rs" ;
    test:path "tests/max_protocol_notification_fidelity_proof.rs" ;
    test:checkpoint "CP10" ;
    test:testCount 4 .

test:File_max_protocol_gates_and_sparql_derived_proof a test:TestFile ;
    rdfs:label "max_protocol_gates_and_sparql_derived_proof.rs" ;
    test:path "tests/max_protocol_gates_and_sparql_derived_proof.rs" ;
    test:checkpoint "CP10" ;
