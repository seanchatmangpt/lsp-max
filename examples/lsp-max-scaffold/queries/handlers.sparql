PREFIX lsp: <https://microsoft.github.io/language-server-protocol/>
PREFIX law: <https://lsp-max.io/law#>

# CANDIDATE methods — handler stubs whose promotion is OPEN.
# ORDER BY is mandatory under strict_mode (error E0013 at config-validation time).
SELECT ?method
WHERE {
  ?m lsp:methodName ?method ;
     law:status law:CANDIDATE .
}
ORDER BY ?method
